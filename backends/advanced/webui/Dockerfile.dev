# Development Dockerfile for React app
FROM node:22-alpine

WORKDIR /workspace/backends/advanced/webui

# The WebUI consumes the generated Audio V2 package through a repository-local
# file dependency. Keep the container layout compatible with
# ../../../contracts/audio/v2/typescript from package.json.
COPY contracts/audio/v2/typescript /workspace/contracts/audio/v2/typescript

# Copy package files explicitly. Podman/Buildah does not reliably preserve both
# sources when this is expressed as one multi-source COPY into a relative target.
COPY backends/advanced/webui/package.json ./package.json
COPY backends/advanced/webui/package-lock.json ./package-lock.json

# Install dependencies
RUN npm ci

# Copy source code
COPY backends/advanced/webui/ .

# Expose port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "dev"]
