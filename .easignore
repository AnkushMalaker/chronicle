# EAS resolves this monorepo's upload root to the repository because the app
# has a local file dependency on the generated Audio V2 TypeScript package.
# Upload only those two build inputs; everything else is machine-local or a
# sibling Chronicle service that cannot affect the mobile build.
*
!app
!app/**
!contracts
!contracts/audio
!contracts/audio/v2
!contracts/audio/v2/typescript
!contracts/audio/v2/typescript/**

# Reinstalled or regenerated by EAS.
app/node_modules
app/.expo
app/dist
app/web-build
app/android/.gradle
app/android/build
app/android/app/build
app/android/app/.cxx
app/ios/build
app/ios/Pods
app/ios/DerivedData

# Local credentials and build artifacts never belong in the upload.
app/*.env*
app/*.ipa
app/*.apk
app/*.aab
app/*.jks
app/*.p8
app/*.p12
app/*.key
app/*.mobileprovision
app/*.pem
**/.DS_Store
