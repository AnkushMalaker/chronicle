# Chronicle Vault Sync — Mac configuration
# Copy to .env and fill in. Then: ./start.sh

# Backend URL. If you run Tailscale you can leave this blank and it will be
# auto-discovered; otherwise set your server's address explicitly.
# BACKEND_URL=https://my-host.ts.net

# Chronicle login (same account you use for the web dashboard).
AUTH_USERNAME=admin@example.com
AUTH_PASSWORD=

# Where the vault is synced on this Mac (you can also pick it from the menu).
LOCAL_VAULT_DIR=~/ChronicleVault

# Optional: how this device appears on the server (defaults to the Mac hostname).
# DEVICE_NAME=my-macbook

# Optional: local Syncthing REST port (default 8385; change if it clashes).
# VAULT_SYNC_GUI_PORT=8385
