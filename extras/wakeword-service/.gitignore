# Trained model artifacts (large binaries; produced by training/, vendored at deploy)
models/*.onnx
models/*.pt

# Locally-built nanowakeword wheel (staged by build_nanowakeword.sh)
vendor/

# Captured data-collection clips (false-positive / primed-positive WAVs + meta).
# User audio + regenerable training inputs — never commit.
data/

