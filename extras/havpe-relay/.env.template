# Backend Configuration
BACKEND_URL="http://host.docker.internal:8000"
BACKEND_WS_URL="ws://host.docker.internal:8000"

# Authentication — long-lived key from the webui (Settings → API Keys).
# `uv run python init.py` can mint this for you.
CHRONICLE_API_KEY=

# Device Configuration
DEVICE_NAME=havpe
TCP_PORT=8989

# ESPHome device IP (optional). If set, the relay connects ESPHome API to this
# IP for LED/speaker/button control instead of using the TCP client's IP.
# Set this to your ESP32's LAN IP for reliable ESPHome connectivity.
# ESPHOME_DEVICE_IP=192.168.0.149
