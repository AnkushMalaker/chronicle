# Known wearable devices
devices: []
  # - mac: "AA:BB:CC:DD:EE:FF"
  #   name: "my-neo1"
  #   type: "neo1"          # neo1 or omi

# Auto-discovery: connect to any recognized OMI/Neo device in range
auto_discover: true

# Seconds between scans when no device is connected
scan_interval: 10

# Host output safety. "auto" allows verified headphones and otherwise gates
# capture while speakers play. Other values: require_headphones, always_half_duplex.
voice_output_policy: auto

# Last connected device MAC (auto-populated on successful connection)
# last_connected: "AA:BB:CC:DD:EE:FF"
