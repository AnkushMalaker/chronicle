# ASR Services Configuration
# Copy this file to .env and configure as needed

# =============================================================================
# Provider Selection
# =============================================================================
# Choose one of: faster-whisper, transformers, nemo, gemma4, qwen3-asr, vibevoice, af-next
ASR_PROVIDER=nemo

# =============================================================================
# Model Configuration
# =============================================================================
# Model identifier (HuggingFace repo or local path)
#
# Faster-Whisper models:
#   - Systran/faster-whisper-large-v3 (Best quality)
#   - Systran/faster-whisper-small (Lightweight)
#   - deepdml/faster-whisper-large-v3-turbo-ct2 (Speed optimized)
#
# Transformers models:
#   - microsoft/VibeVoice-ASR-HF (7B, speaker diarization)
#   - Oriserve/Whisper-Hindi2Hinglish-Prime (Hindi/Hinglish)
#   - openai/whisper-large-v3 (Original Whisper)
#
# NeMo models:
#   - nvidia/parakeet-tdt-0.6b-v3 (Default)
#   - nvidia/canary-1b (Multilingual)
#
ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# =============================================================================
# Service Port Configuration
# =============================================================================
ASR_PORT=8767

# =============================================================================
# PyTorch/CUDA Configuration
# =============================================================================
# Options: cu121 (CUDA 12.1), cu126 (CUDA 12.6), cu128 (CUDA 12.8)
PYTORCH_CUDA_VERSION=cu126

# =============================================================================
# Faster-Whisper Provider Settings
# =============================================================================
# Quantization type: float16, int8, float32
COMPUTE_TYPE=float16

# Device: cuda, cpu
DEVICE=cuda

# GPU device index (for multi-GPU systems)
DEVICE_INDEX=0

# Enable Voice Activity Detection filtering
VAD_FILTER=true

# Force language (empty for auto-detect)
# LANGUAGE=en

# =============================================================================
# Transformers Provider Settings
# =============================================================================
# PyTorch data type: float16, float32, bfloat16
# (used by faster-whisper / transformers providers; fp16 is fine for those)
TORCH_DTYPE=float16

# VibeVoice dtype — keep bfloat16. fp16 overflows in VibeVoice's long
# autoregressive decode → repetition/template-leak COLLAPSE on hard far-field
# audio (and ~2.4x slower from runaway generation). Dedicated var so VibeVoice
# never inherits the global TORCH_DTYPE above. Only set float16 if you really
# mean it.
VIBEVOICE_TORCH_DTYPE=bfloat16

# Enable Flash Attention 2 (requires compatible GPU)
USE_FLASH_ATTENTION=false

# =============================================================================
# NeMo Provider Settings
# =============================================================================
# NeMo's transcribe() handles long audio natively with timestamps=True.
# No additional configuration needed.

# =============================================================================
# Gemma 4 Provider Settings
# =============================================================================
# Google Gemma 4 multimodal ASR with prompt-based diarization. Default target is
# the E2B-it model; selecting the gemma4 provider sets GEMMA4_MODEL.
# GEMMA4_MODEL=google/gemma-4-E2B-it
#
# Quantization for the E2B target (~10GB in bf16):
#   bf16  - default, full precision, fits a 24GB GPU comfortably
#   8bit  - ~6GB, slightly lower fidelity, slower decode
#   4bit  - ~4GB, for smaller GPUs
GEMMA4_QUANT=bf16
#
# Multi-Token Prediction (MTP): a small text-only "-assistant" drafter
# speculatively decodes tokens the target verifies (~1.6x on ASR, no quality
# change). Set 0 to disable. Override the drafter repo if needed (default is
# "${GEMMA4_MODEL}-assistant").
GEMMA4_MTP=1
# GEMMA4_ASSISTANT_MODEL=google/gemma-4-E2B-it-assistant
#
# Streaming (stt-gemma4-stream, the /stream WS endpoint on the same service):
# Gemma has no word timestamps, so streaming re-decodes a bounded rolling window
# for interim previews and runs one full transcription at stream end for the
# final. INTERVAL = how often to emit an interim; WINDOW = how many trailing
# seconds each interim decodes (caps the per-decode cost on long sessions).
GEMMA4_STREAM_INTERVAL_SECONDS=4
GEMMA4_STREAM_WINDOW_SECONDS=30

# --- Cross-service error reporting (backend "System Errors" page) -------------
# Forward this service's ERROR/CRITICAL logs to the backend so failures here
# show up on the admin System Errors page instead of only in container logs.
# Opt-in: set both URL and TOKEN. TOKEN must match the backend's
# SYSTEM_EVENT_INGEST_TOKEN (or its SERVICE_MANAGER_TOKEN, the default fallback).
# On a remote/distributed node, point the URL at the backend's Tailscale name.
# CHRONICLE_INGEST_URL=http://host.docker.internal:8000/api/admin/system-events/ingest
# CHRONICLE_INGEST_TOKEN=
# CHRONICLE_SERVICE_NAME=   # optional label override (defaults to the service name)
